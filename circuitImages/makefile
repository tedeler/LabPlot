# Makefile to compile all .tex files in the latex directory with pdflatex and convert to png

# List all .tex files in the latex directory
TEXFILES := $(wildcard latex/*.tex)

# Define the rule to compile .tex files to .pdf and then convert to .png
all: $(TEXFILES:latex/%.tex=../src/res/fromlatex/%.png)
pdf: $(TEXFILES:latex/%.tex=latex/%.pdf)


latex/%.pdf: latex/%.tex
	pdflatex -output-directory=latex $<

../src/res/fromlatex/%.png: latex/%.pdf
	magick -density 300 $< $@

# Clean up auxiliary files generated by pdflatex and ImageMagick
clean:
	rm -f latex/*.aux latex/*.log latex/*.out latex/*.toc latex/*.pdf ../src/res/fromlatex/*.png

.PHONY: all clean